# =============================================================================
# Garmin Coach — configurazione
#
# Le credenziali Garmin NON stanno qui: dalla v2 sono per-utente e vengono
# inserite al login, poi salvate cifrate nel database.
# =============================================================================

# Dove salvare i token di sessione Garmin (una sottocartella per utente)
GARMIN_TOKENSTORE=./data/garmin_tokens

# Database (SQLite in locale; su Hetzner postgresql+psycopg://utente:pw@postgres:5432/garmin)
DATABASE_URL=sqlite:///./data/garmin_connector.db

# --- Auth (OBBLIGATORI) ---
# FERNET_KEY: cifra le password Garmin nel DB. Se la perdi, gli utenti devono rifare il login.
#   genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# SESSION_SECRET: firma i cookie di sessione. Cambiarlo disconnette tutti.
#   genera con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# --- AI ---
# AI_PROVIDER: stub | claude | openai
AI_PROVIDER=stub
ANTHROPIC_API_KEY=
CLAUDE_MODEL_LIGHT=claude-haiku-4-5-20251001
CLAUDE_MODEL_HEAVY=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Scheduler (sync automatica giornaliera) ---
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Europe/Rome
SYNC_HOUR=6
SYNC_MINUTE=30
# minuti di pausa tra un utente e l'altro, per non martellare Garmin
SYNC_STAGGER_MINUTES=3
