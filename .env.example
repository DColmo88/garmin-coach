# Credenziali Garmin Connect
GARMIN_EMAIL=tua_email@example.com
GARMIN_PASSWORD=la_tua_password

# Dove salvare il token di sessione Garmin (per non rifare il login ogni volta)
GARMIN_TOKENSTORE=./data/garmin_tokens

# Database (SQLite ora; in futuro su Hetzner basta cambiare in postgresql://...)
DATABASE_URL=sqlite:///./data/garmin_connector.db

